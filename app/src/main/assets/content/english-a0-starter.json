        {
          "id": "en-a0-articles",
          "title": "A book, an apple",
          "objectives": [
            "Use a and an with singular countable nouns.",
            "Choose the article from the next spoken sound."
          ],
          "explanationRomanUrdu": "A aur an kisi aik ghair-muayyan, ginay ja sakne walay naam ke saath lagte hain. Agla lafz consonant sound se shuru ho to a, aur vowel sound se shuru ho to an lagta hai. Faisla awaaz se hota hai, sirf pehle likhay harf se nahin. Misal: a book, an apple.",
          "rulesRomanUrdu": [
            "Consonant sound se pehle a: a book, a pen.",
            "Vowel sound se pehle an: an apple, an egg.",
            "A/an sirf singular countable noun ke saath lagta hai. Books ke saath a/an nahin aata.",
            "Awaaz dekhein: a university mein pehli awaaz yoo hai; an hour mein h ki awaaz nahin aati."
          ],
          "examples": [
            {
              "text": "This is a book.",
              "meaningRomanUrdu": "Yeh aik kitab hai.",
              "speech": {
                "text": "This is a book.",
                "languageTag": "en"
              }
            },
            {
              "text": "It is an apple.",
              "meaningRomanUrdu": "Yeh aik saib hai.",
              "speech": {
                "text": "It is an apple.",
                "languageTag": "en"
              }
            },
            {
              "text": "She is a student.",
              "meaningRomanUrdu": "Woh aik talib-e-ilm hai.",
              "speech": {
                "text": "She is a student.",
                "languageTag": "en"
              }
            }
          ],
