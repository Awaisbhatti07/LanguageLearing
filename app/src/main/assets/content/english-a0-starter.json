        {
          "id": "en-a0-pronouns-be",
          "title": "I am, you are, she is",
          "objectives": [
            "Choose am, is or are with a subject.",
            "Understand basic subject pronouns."
          ],
          "explanationRomanUrdu": "Pronoun naam ki jagah aata hai. I ka matlab main, you ka aap ya tum, he ka woh mard aur she ka woh aurat hai. Be verb ki soorat subject ke mutabiq badalti hai. I ke saath am; he, she, it ke saath is; you, we, they ke saath are aata hai.",
          "rulesRomanUrdu": [
            "I am; he is; she is; it is.",
            "You are; we are; they are. You aik ya zyada logon ke liye ho, dono mein are aata hai.",
            "Subject aur be verb ke baad naam, pehchan ya halat aati hai: I am happy."
          ],
          "examples": [
            {
              "text": "I am a student.",
              "meaningRomanUrdu": "Main talib-e-ilm hoon.",
              "speech": {
                "text": "I am a student.",
                "languageTag": "en"
              }
            },
            {
              "text": "She is happy.",
              "meaningRomanUrdu": "Woh khush hai.",
              "speech": {
                "text": "She is happy.",
                "languageTag": "en"
              }
            },
            {
              "text": "They are here.",
              "meaningRomanUrdu": "Woh log yahan hain.",
              "speech": {
                "text": "They are here.",
                "languageTag": "en"
              }
            }
          ],
