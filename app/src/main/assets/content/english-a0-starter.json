      "lessons": [
        {
          "id": "en-a0-greetings",
          "title": "Hello and introductions",
          "objectives": [
            "Greet someone politely.",
            "Say your name in a short sentence."
          ],
          "explanationRomanUrdu": "Kisi se milte waqt Hello keh sakte hain. Apna naam batane ke liye My name is ... bolain. Yeh jumla har naam ke saath isi tarah istemal hota hai. Good morning subah ki mulaqat mein aur Goodbye rukhsat hote waqt kehte hain.",
          "rulesRomanUrdu": [
            "My name is ke baad apna naam likhain: My name is Sara.",
            "Hello aam greeting hai; Goodbye alvida kehne ke liye hai.",
            "Naam ka pehla harf capital hota hai. Jumlay ke aakhir mein full stop lagta hai."
          ],
          "examples": [
            {
              "text": "Hello. My name is Sara.",
              "meaningRomanUrdu": "Salam. Mera naam Sara hai.",
              "speech": {
                "text": "Hello. My name is Sara.",
                "languageTag": "en"
              }
            },
            {
              "text": "Good morning, Ali.",
              "meaningRomanUrdu": "Subah bakhair, Ali.",
              "speech": {
                "text": "Good morning, Ali.",
                "languageTag": "en"
              }
            },
            {
              "text": "Goodbye, Sara.",
              "meaningRomanUrdu": "Alvida, Sara.",
              "speech": {
                "text": "Goodbye, Sara.",
                "languageTag": "en"
              }
            }
          ],
          "vocabulary": [
